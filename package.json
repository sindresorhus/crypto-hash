{
	"name": "crypto-hash",
	"version": "4.0.0",
	"description": "Tiny hashing module that uses the native crypto API in Node.js and the browser",
	"license": "MIT",
	"repository": "sindresorhus/crypto-hash",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"node": "./index.js",
		"default": "./browser.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test:node": "xo && ava test.js",
		"test:browser": "npx playwright install chromium && npx playwright test",
		"test": "npm run test:node && npm run test:browser"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"browser.js",
		"thread.js",
		"utilities.js"
	],
	"keywords": [
		"crypto",
		"hash",
		"isomorphic",
		"hashing",
		"hasher",
		"cryptography",
		"sha1",
		"sha256",
		"sha384",
		"sha512",
		"browser"
	],
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@sindresorhus/is": "^7.0.2",
		"ava": "^6.4.1",
		"hash.js": "^1.1.7",
		"serve": "^14.2.5",
		"xo": "^0.59.0"
	}
}
